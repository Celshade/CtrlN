# CtrlN Configuration Template
# Copy this file to appropriate locations and fill in your values

# ═══════════════════════════════════════════════════════════════────
# Android Build Configuration (godot/.env.build)
# ═══════════════════════════════════════════════════════════════════
# Path to Android keystore file (relative to godot/ directory)
export GODOT_ANDROID_KEYSTORE_RELEASE_PATH="./ctrln-release.keystore"

# Keystore alias (username for signing)
export GODOT_ANDROID_KEYSTORE_RELEASE_USER="ctrln"

# Keystore password (keep secure; never commit)
export GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD="<your-keystore-password-here>"

# ═══════════════════════════════════════════════════════════════════
# Game Configuration (src/ctrln/config.py)
# ═══════════════════════════════════════════════════════════════════
# Game window dimensions
GAME_WIDTH=1280
GAME_HEIGHT=720

# Character unlock system
USE_ACHIEVEMENTS=true

# ═══════════════════════════════════════════════════════════════════
# Developer Settings
# ═══════════════════════════════════════════════════════════════════
DEBUG=false
